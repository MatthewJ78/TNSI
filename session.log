********* QUERY **********
DROP TABLE IF EXISTS ville;
**************************

DROP TABLE
********* QUERY **********
CREATE TABLE ville(
ID INT PRIMARY KEY,
Dep VARCHAR(3),
Nom VARCHAR(255),
CodePostal VARCHAR(255),
INSEE VARCHAR(10),
Habitants INT,
Densite REAL,
Surface REAL,
Longitude REAL,
Latitude REAL,
Altitude VARCHAR(255)
);
**************************

CREATE TABLE
********* QUERY **********
COPY ville (ID,
Dep,
Nom,
CodePostal,
INSEE,
Habitants,
Densite,
Surface,
Longitude,
Latitude,
Altitude)
FROM '/tmp/villesfrance.csv' DELIMITER ',' CSV HEADER;
**************************

